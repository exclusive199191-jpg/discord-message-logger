# Environment configuration - copy to .env and fill in values

# Discord Bot Configuration
DISCORD_USER_TOKEN=your_discord_token_here
DISCORD_API_BASE=https://discord.com/api/v10

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/discord_logger

# Flask Configuration
FLASK_SECRET_KEY=your_secret_key_here_change_this
FLASK_ENV=production

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Logging
LOG_LEVEL=INFO
